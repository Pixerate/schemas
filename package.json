{
  "name": "@pixerate/schemas",
  "version": "1.31.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js",
      "require": "./dist/realtime.cjs"
    },
    "./genui": {
      "types": "./dist/genui.d.ts",
      "import": "./dist/genui.js",
      "require": "./dist/genui.cjs"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js",
      "require": "./dist/media.cjs"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "require": "./dist/agent.cjs"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "import": "./dist/jobs.js",
      "require": "./dist/jobs.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/realtime.ts src/genui.ts src/media.ts src/agent.ts src/jobs.ts --format esm,cjs --dts --clean",
    "prepare": "npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pixerate/schemas.git"
  },
  "bugs": {
    "url": "https://github.com/Pixerate/schemas/issues"
  },
  "homepage": "https://github.com/Pixerate/schemas#readme",
  "author": "Pixerate",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
