{
  "name": "@pixerate/schemas",
  "version": "1.9.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepare": "npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pixerate/schemas.git"
  },
  "bugs": {
    "url": "https://github.com/Pixerate/schemas/issues"
  },
  "homepage": "https://github.com/Pixerate/schemas#readme",
  "author": "Pixerate",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
