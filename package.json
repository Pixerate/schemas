{
  "name": "@pixerate/schemas",
  "version": "1.51.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js",
      "require": "./dist/realtime.cjs"
    },
    "./genui": {
      "types": "./dist/genui.d.ts",
      "import": "./dist/genui.js",
      "require": "./dist/genui.cjs"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js",
      "require": "./dist/media.cjs"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "require": "./dist/agent.cjs"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "import": "./dist/jobs.js",
      "require": "./dist/jobs.cjs"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "import": "./dist/analytics.js",
      "require": "./dist/analytics.cjs"
    },
    "./jazz": {
      "types": "./dist/jazz.d.ts",
      "import": "./dist/jazz.js",
      "require": "./dist/jazz.cjs"
    },
    "./skills": {
      "types": "./dist/skills.d.ts",
      "import": "./dist/skills.js",
      "require": "./dist/skills.cjs"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.js",
      "require": "./dist/common.cjs"
    },
    "./json-schema/*": "./json-schema/*"
  },
  "scripts": {
    "build": "tsup src/index.ts src/realtime.ts src/genui.ts src/media.ts src/agent.ts src/jobs.ts src/analytics.ts src/jazz.ts src/common.ts src/skills.ts --format esm,cjs --dts --clean && npm run export:json-schema",
    "export:json-schema": "node scripts/export-json-schema.mjs",
    "gen:swift": "node scripts/gen-swift.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepare": "npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pixerate/schemas.git"
  },
  "bugs": {
    "url": "https://github.com/Pixerate/schemas/issues"
  },
  "homepage": "https://github.com/Pixerate/schemas#readme",
  "author": "Pixerate",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "json-schema"
  ],
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsup": "^9.0.0",
    "typescript": "^5.4.5",
    "zod-to-json-schema": "^3.25.2"
  }
}
