{
  "$ref": "#/definitions/Finding",
  "definitions": {
    "Finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "cohort": {
          "type": "string",
          "minLength": 1
        },
        "user_segment": {
          "$ref": "#/definitions/FindingUserSegment",
          "default": "all"
        },
        "affected_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "severity": {
          "$ref": "#/definitions/FindingSeverity"
        },
        "suggested_fix": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/definitions/FindingStatus",
          "default": "open"
        },
        "flow_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "product",
        "title",
        "cohort",
        "affected_share",
        "evidence",
        "severity",
        "suggested_fix"
      ],
      "additionalProperties": false
    },
    "FindingSeverity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "FindingStatus": {
      "type": "string",
      "enum": [
        "open",
        "acknowledged",
        "resolved",
        "dismissed"
      ]
    },
    "FindingUserSegment": {
      "type": "string",
      "enum": [
        "new",
        "returning",
        "all"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
