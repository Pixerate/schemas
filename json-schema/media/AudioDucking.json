{
  "$ref": "#/definitions/AudioDucking",
  "definitions": {
    "AudioDucking": {
      "type": "object",
      "properties": {
        "voicePath": {
          "type": "string"
        },
        "musicPath": {
          "type": "string"
        },
        "outputPath": {
          "type": "string"
        },
        "options": {
          "$ref": "#/definitions/AudioDuckingOptions"
        }
      },
      "required": [
        "voicePath",
        "musicPath"
      ],
      "additionalProperties": false
    },
    "AudioDuckingOptions": {
      "type": "object",
      "properties": {
        "duckingDb": {
          "type": "number",
          "default": 14
        },
        "attackMs": {
          "type": "number",
          "default": 20
        },
        "releaseMs": {
          "type": "number",
          "default": 250
        },
        "threshold": {
          "type": "number",
          "default": 0.125
        },
        "crf": {
          "type": "number"
        },
        "preset": {
          "type": "string"
        },
        "videoCodec": {
          "type": "string"
        },
        "audioCodec": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
