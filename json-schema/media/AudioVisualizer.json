{
  "$ref": "#/definitions/AudioVisualizer",
  "definitions": {
    "AudioVisualizer": {
      "type": "object",
      "properties": {
        "audioPath": {
          "type": "string"
        },
        "outputPath": {
          "type": "string"
        },
        "options": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "waves",
                "spectrum",
                "bars"
              ],
              "default": "waves"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 1280
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 720
            },
            "fps": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 30
            },
            "colors": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "enum": [
                "point",
                "line",
                "p2p",
                "cline"
              ]
            },
            "scale": {
              "type": "string",
              "enum": [
                "lin",
                "sqrt",
                "cbrt",
                "log"
              ]
            },
            "background": {
              "type": "string"
            },
            "crf": {
              "type": "number"
            },
            "preset": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "audioPath"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
