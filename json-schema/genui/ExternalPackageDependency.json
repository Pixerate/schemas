{
  "$ref": "#/definitions/ExternalPackageDependency",
  "definitions": {
    "ExternalPackageDependency": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "npm"
        },
        "packageName": {
          "type": "string",
          "description": "NPM package name (e.g. 'bits-ui', '@radix-ui/react-dialog')"
        },
        "versionRange": {
          "type": "string",
          "default": "^1.0.0",
          "description": "Semver range (e.g. '^1.0.0', '^1.1.2')"
        },
        "isPeerDependency": {
          "type": "boolean",
          "default": false
        },
        "importSpecifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "packageName"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
