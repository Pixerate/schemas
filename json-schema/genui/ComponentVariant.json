{
  "$ref": "#/definitions/ComponentVariant",
  "definitions": {
    "ComponentVariant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Slug, e.g., 'glass-card' or 'glassmorphism'"
        },
        "componentTypeId": {
          "type": "string",
          "description": "References UIComponentType.id"
        },
        "name": {
          "type": "string",
          "description": "e.g. 'Glass Action Button'"
        },
        "aestheticId": {
          "type": "string",
          "description": "Deprecated mirror of aesthetic.skillId. Style aesthetic, e.g. 'glassmorphism', 'neubrutalism', 'minimalist', 'modern', 'shadcn'"
        },
        "aesthetic": {
          "$ref": "#/definitions/UiAestheticRef",
          "description": "The ui-aesthetic skill (and version) this variant is styled by"
        },
        "recommendedThemeId": {
          "type": "string",
          "description": "Optional recommended theme ID (e.g., 'shadcn-zinc', 'tokyo-night')"
        },
        "description": {
          "type": "string",
          "description": "Style & business logic description"
        },
        "imageUrl": {
          "type": "string",
          "description": "Optional image URL"
        },
        "image": {
          "type": "string"
        },
        "screenshot": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": [
        "id",
        "componentTypeId",
        "name",
        "aestheticId",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "UiAestheticRef": {
      "type": "object",
      "properties": {
        "skillId": {
          "type": "string",
          "minLength": 1,
          "description": "The aesthetic skill's id, e.g. 'glassmorphism'"
        },
        "version": {
          "type": "string",
          "description": "The skill's semver; absent means the latest"
        },
        "contentHash": {
          "type": "string",
          "description": "The skill's contentHash when the thing was made"
        }
      },
      "required": [
        "skillId"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
