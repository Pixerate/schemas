{
  "$ref": "#/definitions/UiDreamTrigger",
  "definitions": {
    "UiDreamTrigger": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/UiDreamTriggerKind"
        },
        "componentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The component the user acts on"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "For a keyboard trigger, e.g. 'Enter', 'Escape', 'ArrowDown'"
        },
        "direction": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "left",
            "right",
            "in",
            "out"
          ],
          "description": "For a drag, swipe, scroll or pinch"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "UiDreamTriggerKind": {
      "type": "string",
      "enum": [
        "click",
        "hover",
        "focus",
        "press",
        "drag",
        "swipe",
        "scroll",
        "pinch",
        "keyboard",
        "timer",
        "data"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
