{
  "$ref": "#/definitions/SemanticReviewResult",
  "definitions": {
    "SemanticReviewIssue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "fieldId": {
          "type": "string"
        },
        "fieldLabel": {
          "type": "string"
        },
        "suggestion": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "message"
      ],
      "additionalProperties": false
    },
    "SemanticReviewResult": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/definitions/SemanticReviewStatus"
        },
        "summary": {
          "type": "string"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SemanticReviewIssue"
          }
        }
      },
      "required": [
        "status",
        "issues"
      ],
      "additionalProperties": false
    },
    "SemanticReviewStatus": {
      "type": "string",
      "enum": [
        "pass",
        "flagged",
        "unavailable"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
