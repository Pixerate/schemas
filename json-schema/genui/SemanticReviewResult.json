{
  "$ref": "#/definitions/SemanticReviewResult",
  "definitions": {
    "SemanticReviewResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "flagged",
            "unavailable"
          ]
        },
        "summary": {
          "type": "string"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "warning",
                  "error"
                ]
              },
              "message": {
                "type": "string"
              },
              "fieldId": {
                "type": "string"
              },
              "fieldLabel": {
                "type": "string"
              },
              "suggestion": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "severity",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "issues"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
