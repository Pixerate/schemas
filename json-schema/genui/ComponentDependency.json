{
  "$ref": "#/definitions/ComponentDependency",
  "definitions": {
    "ComponentDependency": {
      "anyOf": [
        {
          "$ref": "#/definitions/InternalComponentDependency"
        },
        {
          "$ref": "#/definitions/ExternalPackageDependency"
        }
      ]
    },
    "ExternalPackageDependency": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "npm"
        },
        "packageName": {
          "type": "string",
          "description": "NPM package name (e.g. 'bits-ui', '@radix-ui/react-dialog')"
        },
        "versionRange": {
          "type": "string",
          "default": "^1.0.0",
          "description": "Semver range (e.g. '^1.0.0', '^1.1.2')"
        },
        "isPeerDependency": {
          "type": "boolean",
          "default": false
        },
        "importSpecifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "packageName"
      ],
      "additionalProperties": false
    },
    "InternalComponentDependency": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "surreal"
        },
        "componentTypeId": {
          "type": "string",
          "description": "Slug of target component type (e.g. 'button')"
        },
        "aestheticId": {
          "type": "string",
          "description": "Aesthetic style ID (e.g. 'glassmorphism')"
        },
        "variantId": {
          "type": "string",
          "description": "Variant ID (e.g. 'glass-action-button')"
        },
        "versionRange": {
          "type": "string",
          "default": "^1.0.0",
          "description": "Semver range required"
        },
        "importedAs": {
          "type": "string",
          "description": "Local identifier name (e.g. 'Button')"
        }
      },
      "required": [
        "type",
        "componentTypeId",
        "importedAs"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
