{
  "$ref": "#/definitions/DecisionGate",
  "definitions": {
    "Condition": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "fieldId": {
          "type": "string"
        },
        "operator": {
          "$ref": "#/definitions/ConditionOperator"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "required": [
        "operator"
      ],
      "additionalProperties": false
    },
    "ConditionOperator": {
      "type": "string",
      "enum": [
        "equals",
        "notEquals",
        "not_equals",
        "includes",
        "contains",
        "greaterThan",
        "greater_than",
        "lessThan",
        "less_than",
        "exists"
      ]
    },
    "DecisionGate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "stageId": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/DecisionGateKind"
        },
        "trigger": {
          "type": "string"
        },
        "requiredAction": {
          "type": "string"
        },
        "consequence": {
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/definitions/Condition"
            },
            {
              "type": "string"
            }
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "reviewerRole": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "stageId",
        "blocking"
      ],
      "additionalProperties": false
    },
    "DecisionGateKind": {
      "type": "string",
      "enum": [
        "approval",
        "review",
        "decision"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
