{
  "$ref": "#/definitions/DecisionGate",
  "definitions": {
    "DecisionGate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "stageId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "approval",
            "review",
            "decision"
          ]
        },
        "trigger": {
          "type": "string"
        },
        "requiredAction": {
          "type": "string"
        },
        "consequence": {
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "fieldId": {
                  "type": "string"
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "equals",
                    "notEquals",
                    "not_equals",
                    "includes",
                    "contains",
                    "greaterThan",
                    "greater_than",
                    "lessThan",
                    "less_than",
                    "exists"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              "required": [
                "operator"
              ],
              "additionalProperties": false
            },
            {
              "type": "string"
            }
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "reviewerRole": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "stageId",
        "blocking"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
