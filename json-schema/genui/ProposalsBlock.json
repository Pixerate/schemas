{
  "$ref": "#/definitions/ProposalsBlock",
  "definitions": {
    "ProposalItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "urgent"
          ]
        },
        "estimatedHours": {
          "type": "number"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false
    },
    "ProposalsBlock": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "proposals",
            "followup",
            "follow-up"
          ],
          "default": "proposals"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProposalItem"
          },
          "minItems": 1
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
