{
  "$ref": "#/definitions/PictureRef",
  "definitions": {
    "PageThemeMode": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ]
    },
    "PictureRef": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "URL, data URI or storage path of the image"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "theme": {
          "$ref": "#/definitions/PageThemeMode"
        },
        "at": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "hover": {
          "type": "string"
        }
      },
      "required": [
        "ref",
        "width",
        "height",
        "theme"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
