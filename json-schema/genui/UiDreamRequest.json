{
  "$ref": "#/definitions/UiDreamRequest",
  "definitions": {
    "PageThemeMode": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ]
    },
    "PlatformTarget": {
      "type": "string",
      "enum": [
        "svelte",
        "react",
        "webcomponent",
        "swiftui",
        "compose",
        "html-page"
      ]
    },
    "UiAestheticRef": {
      "type": "object",
      "properties": {
        "skillId": {
          "type": "string",
          "minLength": 1,
          "description": "The aesthetic skill's id, e.g. 'glassmorphism'"
        },
        "version": {
          "type": "string",
          "description": "The skill's semver; absent means the latest"
        },
        "contentHash": {
          "type": "string",
          "description": "The skill's contentHash when the thing was made"
        }
      },
      "required": [
        "skillId"
      ],
      "additionalProperties": false
    },
    "UiDreamClipPlan": {
      "type": "object",
      "properties": {
        "fromFrame": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The still the clip starts on (the video model's first frame)"
        },
        "toFrame": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The still the clip ends on (the video model's last frame)"
        },
        "interaction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "What happens, e.g. 'drag the third card to the top of the list'"
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 4,
          "maximum": 8,
          "description": "Clip length in seconds, 4 to 8"
        }
      },
      "required": [
        "fromFrame",
        "toFrame",
        "interaction",
        "durationSeconds"
      ],
      "additionalProperties": false
    },
    "UiDreamFramePlan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Frame id, unique in the request, e.g. 'default' or 'f1'"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The state it shows, e.g. 'default', 'hover', 'open', 'empty', 'loading', 'error'"
        },
        "note": {
          "type": "string",
          "maxLength": 500,
          "description": "What this frame should show, e.g. 'the menu open with three items'"
        }
      },
      "required": [
        "id",
        "state"
      ],
      "additionalProperties": false
    },
    "UiDreamMedium": {
      "type": "string",
      "enum": [
        "stills",
        "clip"
      ]
    },
    "UiDreamRequest": {
      "type": "object",
      "properties": {
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "The user's request, as given"
        },
        "target": {
          "$ref": "#/definitions/UiDreamTarget"
        },
        "medium": {
          "$ref": "#/definitions/UiDreamMedium"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UiDreamFramePlan"
          },
          "minItems": 1,
          "maxItems": 6,
          "description": "The stills to dream, frame 1 first"
        },
        "clip": {
          "$ref": "#/definitions/UiDreamClipPlan",
          "description": "Required when medium is 'clip'; absent otherwise"
        },
        "componentTypeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 20,
          "description": "Catalog hints: UIComponentType ids"
        },
        "aesthetic": {
          "$ref": "#/definitions/UiAestheticRef",
          "description": "The ui-aesthetic skill to dream in"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "The model's prompt, built by genui-core"
        },
        "teamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Team to bill fuel against when the caller belongs to it"
        }
      },
      "required": [
        "brief",
        "target",
        "medium",
        "frames",
        "prompt"
      ],
      "additionalProperties": false
    },
    "UiDreamTarget": {
      "type": "object",
      "properties": {
        "platform": {
          "$ref": "#/definitions/PlatformTarget"
        },
        "viewport": {
          "$ref": "#/definitions/UiDreamViewport"
        },
        "themes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PageThemeMode"
          },
          "minItems": 1,
          "maxItems": 2,
          "default": [
            "light"
          ]
        }
      },
      "required": [
        "platform",
        "viewport"
      ],
      "additionalProperties": false
    },
    "UiDreamViewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "description": "CSS px"
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "description": "CSS px"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
