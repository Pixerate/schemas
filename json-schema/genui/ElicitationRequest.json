{
  "$ref": "#/definitions/ElicitationRequest",
  "definitions": {
    "ElicitationRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "header": {
          "type": "string",
          "maxLength": 12
        },
        "type": {
          "type": "string",
          "enum": [
            "single_select",
            "multi_select",
            "free_form",
            "rank_priorities"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "isRecommended": {
                "type": "boolean"
              },
              "preview": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "contextRationale": {
          "type": "string"
        },
        "allowCustomResponse": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "question",
        "type",
        "options"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
