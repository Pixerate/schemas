{
  "$ref": "#/definitions/ComponentSynthesis",
  "definitions": {
    "ComponentDependency": {
      "anyOf": [
        {
          "$ref": "#/definitions/InternalComponentDependency"
        },
        {
          "$ref": "#/definitions/ExternalPackageDependency"
        }
      ]
    },
    "ComponentDocs": {
      "type": "object",
      "properties": {
        "usage": {
          "type": "string",
          "description": "Usage instructions and import examples"
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ComponentPropDoc"
          },
          "description": "List of prop definitions and types"
        },
        "notes": {
          "type": "string",
          "description": "Additional usage or architectural notes"
        }
      },
      "required": [
        "usage",
        "props"
      ],
      "additionalProperties": false
    },
    "ComponentPropDoc": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "description"
      ],
      "additionalProperties": false
    },
    "ComponentSynthesis": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the synthesized component"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the component"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Keywords and categorization tags"
        },
        "platforms": {
          "type": "object",
          "properties": {
            "svelte": {
              "type": "string",
              "description": "Self-contained Svelte 5 component with runes ($props, $state, onclick, snippets, etc.)"
            },
            "react": {
              "type": "string",
              "description": "Self-contained React 19 TSX component with all subcomponents defined and exported"
            },
            "webcomponent": {
              "type": "string",
              "description": "Self-contained WebComponent custom element extending HTMLElement"
            }
          },
          "required": [
            "svelte",
            "react",
            "webcomponent"
          ],
          "additionalProperties": false
        },
        "harnesses": {
          "type": "object",
          "properties": {
            "svelte": {
              "$ref": "#/definitions/PreviewHarness"
            },
            "react": {
              "$ref": "#/definitions/PreviewHarness"
            },
            "webcomponent": {
              "$ref": "#/definitions/PreviewHarness"
            }
          },
          "required": [
            "svelte",
            "react",
            "webcomponent"
          ],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "svelte": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ComponentDependency"
              },
              "default": []
            },
            "react": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ComponentDependency"
              },
              "default": []
            },
            "webcomponent": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ComponentDependency"
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "docs": {
          "$ref": "#/definitions/ComponentDocs"
        },
        "isValid": {
          "type": "boolean",
          "description": "Whether synthesized code passed validation"
        },
        "validationAttempts": {
          "type": "integer",
          "description": "Total number of validation/repair attempts"
        },
        "validationError": {
          "type": "string",
          "description": "Validation error if still failing after max retries"
        }
      },
      "required": [
        "title",
        "description",
        "tags",
        "platforms",
        "docs"
      ],
      "additionalProperties": false
    },
    "ExternalPackageDependency": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "npm"
        },
        "packageName": {
          "type": "string",
          "description": "NPM package name (e.g. 'bits-ui', '@radix-ui/react-dialog')"
        },
        "versionRange": {
          "type": "string",
          "default": "^1.0.0",
          "description": "Semver range (e.g. '^1.0.0', '^1.1.2')"
        },
        "isPeerDependency": {
          "type": "boolean",
          "default": false
        },
        "importSpecifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "packageName"
      ],
      "additionalProperties": false
    },
    "InternalComponentDependency": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "surreal"
        },
        "componentTypeId": {
          "type": "string",
          "description": "Slug of target component type (e.g. 'button')"
        },
        "aestheticId": {
          "type": "string",
          "description": "Aesthetic style ID (e.g. 'glassmorphism')"
        },
        "variantId": {
          "type": "string",
          "description": "Variant ID (e.g. 'glass-action-button')"
        },
        "versionRange": {
          "type": "string",
          "default": "^1.0.0",
          "description": "Semver range required"
        },
        "importedAs": {
          "type": "string",
          "description": "Local identifier name (e.g. 'Button')"
        }
      },
      "required": [
        "type",
        "componentTypeId",
        "importedAs"
      ],
      "additionalProperties": false
    },
    "PreviewHarness": {
      "type": "object",
      "properties": {
        "driverCode": {
          "type": "string",
          "description": "Complete, runnable preview driver code harness demonstrating usage of the component with snippets/children or mock props"
        },
        "mockProps": {
          "type": "object",
          "additionalProperties": {},
          "description": "JSON map of realistic mock prop values passed to the component"
        },
        "wrapperClass": {
          "type": "string",
          "description": "Tailwind CSS class string for wrapping the preview container"
        }
      },
      "required": [
        "driverCode",
        "mockProps"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
