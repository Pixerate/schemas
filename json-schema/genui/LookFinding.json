{
  "$ref": "#/definitions/LookFinding",
  "definitions": {
    "LookFinding": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "What a look (vision) check saw"
        },
        "severity": {
          "$ref": "#/definitions/LookStatus",
          "default": "warn"
        },
        "ruleId": {
          "type": "string",
          "description": "The aesthetic rule it relates to"
        },
        "referenceId": {
          "type": "string",
          "description": "The aesthetic reference it relates to"
        },
        "picture": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "LookStatus": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
