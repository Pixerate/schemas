{
  "$ref": "#/definitions/LookResult",
  "definitions": {
    "LookCheck": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Check id, e.g. 'contrast', 'hit-target', 'reduced-motion', 'axe'"
        },
        "status": {
          "$ref": "#/definitions/LookStatus"
        },
        "message": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "description": "What it's about: a CSS selector, a prop, or an element description"
        },
        "ruleId": {
          "type": "string",
          "description": "The aesthetic rule it enforces, if any"
        },
        "picture": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into LookResult.pictures"
        }
      },
      "required": [
        "id",
        "status",
        "message"
      ],
      "additionalProperties": false
    },
    "LookFinding": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "What a look (vision) check saw"
        },
        "severity": {
          "$ref": "#/definitions/LookStatus",
          "default": "warn"
        },
        "ruleId": {
          "type": "string",
          "description": "The aesthetic rule it relates to"
        },
        "referenceId": {
          "type": "string",
          "description": "The aesthetic reference it relates to"
        },
        "picture": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "LookResult": {
      "type": "object",
      "properties": {
        "pictures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PictureRef"
          },
          "default": []
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LookCheck"
          },
          "default": []
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LookFinding"
          },
          "default": []
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Overall, from a look check; 1 is a perfect match to the aesthetic"
        },
        "aesthetic": {
          "$ref": "#/definitions/UiAestheticRef"
        },
        "dream": {
          "$ref": "#/definitions/UiDreamComparison",
          "description": "How the result compares with the UI dream it was built from"
        }
      },
      "additionalProperties": false
    },
    "LookStatus": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "PageThemeMode": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ]
    },
    "PictureRef": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "URL, data URI or storage path of the image"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "theme": {
          "$ref": "#/definitions/PageThemeMode"
        },
        "at": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "hover": {
          "type": "string"
        }
      },
      "required": [
        "ref",
        "width",
        "height",
        "theme"
      ],
      "additionalProperties": false
    },
    "UiAestheticRef": {
      "type": "object",
      "properties": {
        "skillId": {
          "type": "string",
          "minLength": 1,
          "description": "The aesthetic skill's id, e.g. 'glassmorphism'"
        },
        "version": {
          "type": "string",
          "description": "The skill's semver; absent means the latest"
        },
        "contentHash": {
          "type": "string",
          "description": "The skill's contentHash when the thing was made"
        }
      },
      "required": [
        "skillId"
      ],
      "additionalProperties": false
    },
    "UiDreamComparison": {
      "type": "object",
      "properties": {
        "dreamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The UiDreamResult compared against"
        },
        "pairs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UiDreamComparisonPair"
          },
          "maxItems": 18,
          "default": []
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Overall structural match; 1 is a perfect match"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LookFinding"
          },
          "default": [],
          "description": "The comparison's findings, also in LookResult.findings with referenceId 'dream:<frameId>'"
        }
      },
      "required": [
        "score"
      ],
      "additionalProperties": false
    },
    "UiDreamComparisonPair": {
      "type": "object",
      "properties": {
        "frameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The dream frame"
        },
        "picture": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into LookResult.pictures"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The state both show"
        },
        "componentsPresent": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 100,
          "default": [],
          "description": "Analysis component ids found in the picture"
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 100,
          "default": [],
          "description": "Analysis component ids not found in the picture"
        },
        "extra": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxItems": 100,
          "default": [],
          "description": "What the picture has that the dream doesn't, described"
        },
        "layoutMatch": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How closely the layout matches; 1 is the same arrangement"
        }
      },
      "required": [
        "frameId",
        "picture",
        "state",
        "layoutMatch"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
