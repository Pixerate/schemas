{
  "$ref": "#/definitions/ComponentVersion",
  "definitions": {
    "ComponentDependency": {
      "anyOf": [
        {
          "$ref": "#/definitions/InternalComponentDependency"
        },
        {
          "$ref": "#/definitions/ExternalPackageDependency"
        }
      ]
    },
    "ComponentDocs": {
      "type": "object",
      "properties": {
        "usage": {
          "type": "string",
          "description": "Usage instructions and import examples"
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ComponentPropDoc"
          },
          "description": "List of prop definitions and types"
        },
        "notes": {
          "type": "string",
          "description": "Additional usage or architectural notes"
        }
      },
      "required": [
        "usage",
        "props"
      ],
      "additionalProperties": false
    },
    "ComponentPackage": {
      "type": "object",
      "properties": {
        "language": {
          "$ref": "#/definitions/PlatformLanguage"
        },
        "code": {
          "type": "string",
          "description": "Formatted code bundle with trimmed leading whitespace"
        },
        "docs": {
          "$ref": "#/definitions/ComponentDocs"
        },
        "screenshot": {
          "type": "string",
          "description": "Deprecated, use screenshots. Data URI or URL of actual rendered component"
        },
        "themeSupport": {
          "$ref": "#/definitions/ThemeSupport"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ComponentDependency"
          },
          "default": []
        },
        "previewHarness": {
          "$ref": "#/definitions/PreviewHarness"
        },
        "source": {
          "$ref": "#/definitions/ComponentSource",
          "description": "Where the package came from; absent for packages made before sources were recorded"
        },
        "runtime": {
          "$ref": "#/definitions/ComponentRuntime",
          "description": "Absent means 'code'"
        },
        "screenshots": {
          "$ref": "#/definitions/ComponentScreenshots"
        }
      },
      "required": [
        "language",
        "code",
        "docs",
        "screenshot",
        "themeSupport",
        "tags"
      ],
      "additionalProperties": false
    },
    "ComponentPropDoc": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "description"
      ],
      "additionalProperties": false
    },
    "ComponentRuntime": {
      "type": "string",
      "enum": [
        "code",
        "engine"
      ],
      "description": "code: source you install and own; engine: a fixed, reviewed runtime that takes data"
    },
    "ComponentScreenshots": {
      "type": "object",
      "properties": {
        "light": {
          "type": "string",
          "description": "URL or data URI of a real render in light mode"
        },
        "dark": {
          "type": "string",
          "description": "URL or data URI of a real render in dark mode"
        }
      },
      "additionalProperties": false
    },
    "ComponentSource": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "flair",
            "editor",
            "generated",
            "manual"
          ]
        },
        "itemId": {
          "type": "string",
          "description": "The provider's id for the item, e.g. Flair's 'toggle-switch'"
        },
        "version": {
          "type": "string",
          "description": "The provider package's version, or the generator's"
        },
        "contentHash": {
          "type": "string"
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
    "ComponentVersion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique version ID e.g. 'button-glass-action-button-v1.0.0'"
        },
        "componentTypeId": {
          "type": "string",
          "description": "References UIComponentType.id"
        },
        "variantId": {
          "type": "string",
          "description": "References ComponentVariant.id"
        },
        "aestheticId": {
          "type": "string",
          "description": "Deprecated mirror of aesthetic.skillId. References Aesthetic style e.g. 'glassmorphism'"
        },
        "aesthetic": {
          "$ref": "#/definitions/UiAestheticRef",
          "description": "The ui-aesthetic skill version this version was built from"
        },
        "version": {
          "type": "string",
          "description": "Semver e.g. '1.0.0'"
        },
        "changelogNote": {
          "type": "string"
        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ComponentPackage"
          },
          "propertyNames": {
            "enum": [
              "svelte",
              "react",
              "webcomponent",
              "swiftui",
              "compose",
              "html-page"
            ]
          }
        }
      },
      "required": [
        "id",
        "componentTypeId",
        "variantId",
        "aestheticId",
        "version",
        "changelogNote",
        "createdBy",
        "createdAt",
        "packages"
      ],
      "additionalProperties": false
    },
    "ExternalPackageDependency": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "npm"
        },
        "packageName": {
          "type": "string",
          "description": "NPM package name (e.g. 'bits-ui', '@radix-ui/react-dialog')"
        },
        "versionRange": {
          "type": "string",
          "default": "^1.0.0",
          "description": "Semver range (e.g. '^1.0.0', '^1.1.2')"
        },
        "isPeerDependency": {
          "type": "boolean",
          "default": false
        },
        "importSpecifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "packageName"
      ],
      "additionalProperties": false
    },
    "InternalComponentDependency": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "surreal"
        },
        "componentTypeId": {
          "type": "string",
          "description": "Slug of target component type (e.g. 'button')"
        },
        "aestheticId": {
          "type": "string",
          "description": "Aesthetic style ID (e.g. 'glassmorphism')"
        },
        "variantId": {
          "type": "string",
          "description": "Variant ID (e.g. 'glass-action-button')"
        },
        "versionRange": {
          "type": "string",
          "default": "^1.0.0",
          "description": "Semver range required"
        },
        "importedAs": {
          "type": "string",
          "description": "Local identifier name (e.g. 'Button')"
        }
      },
      "required": [
        "type",
        "componentTypeId",
        "importedAs"
      ],
      "additionalProperties": false
    },
    "PlatformLanguage": {
      "type": "string",
      "enum": [
        "svelte",
        "react",
        "webcomponent"
      ]
    },
    "PreviewHarness": {
      "type": "object",
      "properties": {
        "driverCode": {
          "type": "string",
          "description": "Complete, runnable preview driver code harness demonstrating usage of the component with snippets/children or mock props"
        },
        "mockProps": {
          "type": "object",
          "additionalProperties": {},
          "description": "JSON map of realistic mock prop values passed to the component"
        },
        "wrapperClass": {
          "type": "string",
          "description": "Tailwind CSS class string for wrapping the preview container"
        }
      },
      "required": [
        "driverCode",
        "mockProps"
      ],
      "additionalProperties": false
    },
    "ThemeSupport": {
      "type": "string",
      "enum": [
        "default",
        "light-and-dark"
      ]
    },
    "UiAestheticRef": {
      "type": "object",
      "properties": {
        "skillId": {
          "type": "string",
          "minLength": 1,
          "description": "The aesthetic skill's id, e.g. 'glassmorphism'"
        },
        "version": {
          "type": "string",
          "description": "The skill's semver; absent means the latest"
        },
        "contentHash": {
          "type": "string",
          "description": "The skill's contentHash when the thing was made"
        }
      },
      "required": [
        "skillId"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
