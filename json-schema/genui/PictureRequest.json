{
  "$ref": "#/definitions/PictureRequest",
  "definitions": {
    "PageThemeMode": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ]
    },
    "PictureRequest": {
      "type": "object",
      "properties": {
        "widths": {
          "type": "array",
          "items": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "minItems": 1,
          "default": [
            1200
          ],
          "description": "CSS px"
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "CSS px; absent means the content's height"
        },
        "themes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PageThemeMode"
          },
          "minItems": 1,
          "default": [
            "light",
            "dark"
          ]
        },
        "at": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 1,
          "default": [
            1
          ],
          "description": "Motion progress values; 1 is at rest"
        },
        "hover": {
          "type": "string",
          "description": "CSS selector of an element to hover before each picture"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4,
          "default": 1,
          "description": "Device pixel ratio"
        },
        "format": {
          "type": "string",
          "enum": [
            "png",
            "jpeg"
          ],
          "default": "png"
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
