{
  "$ref": "#/definitions/UIGenerationOptions",
  "definitions": {
    "PlatformLanguage": {
      "type": "string",
      "enum": [
        "svelte",
        "react",
        "webcomponent"
      ]
    },
    "UiAestheticRef": {
      "type": "object",
      "properties": {
        "skillId": {
          "type": "string",
          "minLength": 1,
          "description": "The aesthetic skill's id, e.g. 'glassmorphism'"
        },
        "version": {
          "type": "string",
          "description": "The skill's semver; absent means the latest"
        },
        "contentHash": {
          "type": "string",
          "description": "The skill's contentHash when the thing was made"
        }
      },
      "required": [
        "skillId"
      ],
      "additionalProperties": false
    },
    "UIGenerationOptions": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "User prompt or instruction for component generation/modification"
        },
        "currentCode": {
          "type": "string",
          "description": "Existing component code for iterative modification"
        },
        "platform": {
          "$ref": "#/definitions/PlatformLanguage",
          "default": "svelte",
          "description": "Target component platform language"
        },
        "theme": {
          "type": "string",
          "description": "Theme identifier or token reference"
        },
        "aesthetic": {
          "$ref": "#/definitions/UiAestheticRef",
          "description": "The ui-aesthetic skill to generate in; the generator loads it rather than a slug"
        },
        "systemPrompt": {
          "type": "string",
          "description": "Custom or override system prompt"
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "default": 3,
          "description": "Maximum retry attempts for iterative auto-repair validation"
        },
        "temperature": {
          "type": "number",
          "description": "Model temperature"
        }
      },
      "required": [
        "prompt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
