{
  "$ref": "#/definitions/ComponentTransformationResult",
  "definitions": {
    "ComponentDependency": {
      "anyOf": [
        {
          "$ref": "#/definitions/InternalComponentDependency"
        },
        {
          "$ref": "#/definitions/ExternalPackageDependency"
        }
      ]
    },
    "ComponentDocs": {
      "type": "object",
      "properties": {
        "usage": {
          "type": "string",
          "description": "Usage instructions and import examples"
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ComponentPropDoc"
          },
          "description": "List of prop definitions and types"
        },
        "notes": {
          "type": "string",
          "description": "Additional usage or architectural notes"
        }
      },
      "required": [
        "usage",
        "props"
      ],
      "additionalProperties": false
    },
    "ComponentPropDoc": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "description"
      ],
      "additionalProperties": false
    },
    "ComponentTransformationResult": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "platforms": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "svelte",
              "react",
              "webcomponent"
            ]
          }
        },
        "harnesses": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/PreviewHarness"
          },
          "propertyNames": {
            "enum": [
              "svelte",
              "react",
              "webcomponent"
            ]
          }
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "svelte": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ComponentDependency"
              },
              "default": []
            },
            "react": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ComponentDependency"
              },
              "default": []
            },
            "webcomponent": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ComponentDependency"
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "docs": {
          "$ref": "#/definitions/ComponentDocs"
        },
        "detectedLanguage": {
          "$ref": "#/definitions/PlatformLanguage"
        },
        "themeSupport": {
          "$ref": "#/definitions/ThemeSupport"
        }
      },
      "required": [
        "title",
        "description",
        "tags",
        "platforms",
        "harnesses",
        "docs",
        "detectedLanguage",
        "themeSupport"
      ],
      "additionalProperties": false
    },
    "ExternalPackageDependency": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "npm"
        },
        "packageName": {
          "type": "string",
          "description": "NPM package name (e.g. 'bits-ui', '@radix-ui/react-dialog')"
        },
        "versionRange": {
          "type": "string",
          "default": "^1.0.0",
          "description": "Semver range (e.g. '^1.0.0', '^1.1.2')"
        },
        "isPeerDependency": {
          "type": "boolean",
          "default": false
        },
        "importSpecifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "packageName"
      ],
      "additionalProperties": false
    },
    "InternalComponentDependency": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "surreal"
        },
        "componentTypeId": {
          "type": "string",
          "description": "Slug of target component type (e.g. 'button')"
        },
        "aestheticId": {
          "type": "string",
          "description": "Aesthetic style ID (e.g. 'glassmorphism')"
        },
        "variantId": {
          "type": "string",
          "description": "Variant ID (e.g. 'glass-action-button')"
        },
        "versionRange": {
          "type": "string",
          "default": "^1.0.0",
          "description": "Semver range required"
        },
        "importedAs": {
          "type": "string",
          "description": "Local identifier name (e.g. 'Button')"
        }
      },
      "required": [
        "type",
        "componentTypeId",
        "importedAs"
      ],
      "additionalProperties": false
    },
    "PlatformLanguage": {
      "type": "string",
      "enum": [
        "svelte",
        "react",
        "webcomponent"
      ]
    },
    "PreviewHarness": {
      "type": "object",
      "properties": {
        "driverCode": {
          "type": "string",
          "description": "Complete, runnable preview driver code harness demonstrating usage of the component with snippets/children or mock props"
        },
        "mockProps": {
          "type": "object",
          "additionalProperties": {},
          "description": "JSON map of realistic mock prop values passed to the component"
        },
        "wrapperClass": {
          "type": "string",
          "description": "Tailwind CSS class string for wrapping the preview container"
        }
      },
      "required": [
        "driverCode",
        "mockProps"
      ],
      "additionalProperties": false
    },
    "ThemeSupport": {
      "type": "string",
      "enum": [
        "default",
        "light-and-dark"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
