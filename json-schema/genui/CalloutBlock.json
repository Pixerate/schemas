{
  "$ref": "#/definitions/CalloutBlock",
  "definitions": {
    "CalloutBlock": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "callout"
        },
        "severity": {
          "type": "string",
          "enum": [
            "risk",
            "opportunity",
            "info",
            "success"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "severity",
        "title"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
