{
  "$ref": "#/definitions/AgentInteractionRequest",
  "definitions": {
    "AgentInteractionRequest": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "default": "antigravity-preview-05-2026"
        },
        "input": {
          "type": "string"
        },
        "systemInstruction": {
          "type": "string"
        },
        "background": {
          "type": "boolean",
          "default": true
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "config": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "agentConfig": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "options": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "remote",
                "local"
              ]
            },
            "network": {
              "type": "object",
              "properties": {
                "allowlist": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "domain": {
                        "type": "string"
                      },
                      "transform": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "key": {
                              "type": "string"
                            },
                            "value": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "key",
                            "value"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "domain"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "data": {
                "type": "string"
              },
              "uri": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              },
              "fileName": {
                "type": "string"
              }
            },
            "required": [
              "mimeType"
            ],
            "additionalProperties": false
          }
        },
        "coachingRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "input"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
