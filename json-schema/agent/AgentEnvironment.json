{
  "$ref": "#/definitions/AgentEnvironment",
  "definitions": {
    "AgentEnvironment": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "remote",
            "local"
          ]
        },
        "network": {
          "type": "object",
          "properties": {
            "allowlist": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AgentNetworkAllowlistRule"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "AgentNetworkAllowlistRule": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string"
        },
        "transform": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AgentNetworkTransformRule"
          }
        }
      },
      "required": [
        "domain"
      ],
      "additionalProperties": false
    },
    "AgentNetworkTransformRule": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
