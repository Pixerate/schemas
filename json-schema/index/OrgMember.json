{
  "$ref": "#/definitions/OrgMember",
  "definitions": {
    "OrgMember": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "orgId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "role": {
          "type": "string",
          "enum": [
            "owner",
            "admin",
            "editor",
            "viewer",
            "member"
          ],
          "default": "member"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "invited",
            "suspended"
          ],
          "default": "active"
        },
        "teamIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "joinedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "invitedBy": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "orgId",
        "userId",
        "email"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
