{
  "$ref": "#/definitions/OrgMember",
  "definitions": {
    "OrgMember": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "orgId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "role": {
          "$ref": "#/definitions/TeamRole",
          "default": "member"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "invited",
            "suspended"
          ],
          "default": "active"
        },
        "teamIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "joinedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "invitedBy": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "orgId",
        "userId",
        "email"
      ],
      "additionalProperties": false
    },
    "TeamRole": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "editor",
        "viewer",
        "member"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
