{
  "$ref": "#/definitions/Invite",
  "definitions": {
    "Invite": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "targetType": {
          "$ref": "#/definitions/InviteTargetType"
        },
        "targetId": {
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "format": "email"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "$ref": "#/definitions/TeamRole",
          "default": "member"
        },
        "invitedBy": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/InviteStatus",
          "default": "pending"
        },
        "maxUses": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "useCount": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "acceptedBy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {},
          "default": {}
        },
        "createdAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      },
      "required": [
        "id",
        "token",
        "targetType",
        "targetId",
        "invitedBy",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "InviteStatus": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "revoked",
        "expired"
      ]
    },
    "InviteTargetType": {
      "type": "string",
      "enum": [
        "organization",
        "team"
      ]
    },
    "TeamRole": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "editor",
        "viewer",
        "member"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
