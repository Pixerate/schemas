{
  "$ref": "#/definitions/Organization",
  "definitions": {
    "ComplimentarySubscription": {
      "type": "object",
      "properties": {
        "planId": {
          "type": "string"
        },
        "expiresAt": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "format": "date-time"
                    }
                  ]
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "grantedBy": {
          "type": "string"
        },
        "grantedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      },
      "required": [
        "planId"
      ],
      "additionalProperties": false
    },
    "Organization": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "memberIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "planId": {
          "type": "string",
          "default": "free"
        },
        "fuelBalance": {
          "type": "number",
          "default": 0
        },
        "stripeCustomerId": {
          "type": "string"
        },
        "stripeSubscriptionId": {
          "type": "string"
        },
        "stripeSubscriptionStatus": {
          "type": "string"
        },
        "cancelAtPeriodEnd": {
          "type": "boolean"
        },
        "billingPeriodStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "billingPeriodEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "complimentary": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "$ref": "#/definitions/ComplimentarySubscription"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {},
          "default": {}
        },
        "createdAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "slug",
        "ownerId"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
