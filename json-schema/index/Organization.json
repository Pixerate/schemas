{
  "$ref": "#/definitions/Organization",
  "definitions": {
    "Organization": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "memberIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "planId": {
          "type": "string",
          "default": "free"
        },
        "fuelBalance": {
          "type": "number",
          "default": 0
        },
        "stripeCustomerId": {
          "type": "string"
        },
        "stripeSubscriptionId": {
          "type": "string"
        },
        "stripeSubscriptionStatus": {
          "type": "string"
        },
        "cancelAtPeriodEnd": {
          "type": "boolean"
        },
        "billingPeriodStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "billingPeriodEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {},
          "default": {}
        },
        "createdAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "slug",
        "ownerId"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
