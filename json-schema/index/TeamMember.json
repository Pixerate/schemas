{
  "$ref": "#/definitions/TeamMember",
  "definitions": {
    "TeamMember": {
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/definitions/TeamRole",
          "default": "member"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "invited",
            "suspended"
          ],
          "default": "active"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "joinedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "invitedBy": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "teamId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "photoURL": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "format": "uri"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "userId",
        "teamId"
      ],
      "additionalProperties": false
    },
    "TeamRole": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "editor",
        "viewer",
        "member"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
