{
  "$ref": "#/definitions/VideoModification",
  "definitions": {
    "VideoAspectRatio": {
      "type": "string",
      "enum": [
        "9:16",
        "16:9"
      ]
    },
    "VideoResolution": {
      "type": "string",
      "enum": [
        "360p",
        "720p",
        "1080p",
        "4k",
        "360P",
        "720P",
        "1080P",
        "4K"
      ]
    },
    "VideoModification": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        },
        "changes": {
          "type": "string"
        },
        "aspectRatio": {
          "$ref": "#/definitions/VideoAspectRatio"
        },
        "durationSeconds": {
          "type": "number"
        },
        "resolution": {
          "$ref": "#/definitions/VideoResolution"
        },
        "task": {
          "type": "string",
          "enum": [
            "modify",
            "extend"
          ]
        },
        "previousInteractionId": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        }
      },
      "required": [
        "prompt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
