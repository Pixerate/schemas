        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "displayName": {
          "type": "string"
        },
        "photoURL": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "format": "uri"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "emailVerified": {
          "type": "boolean",
          "default": false
        },
        "provider": {
          "type": "string",
          "default": "password"
        },
        "createdAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {},
          "default": {}
        }
      },
