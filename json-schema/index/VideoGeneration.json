{
  "$ref": "#/definitions/VideoGeneration",
  "definitions": {
    "VideoGeneration": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        },
        "aspectRatio": {
          "type": "string",
          "enum": [
            "9:16",
            "16:9"
          ]
        },
        "durationSeconds": {
          "type": "integer"
        },
        "generateAudio": {
          "type": "boolean"
        },
        "modelName": {
          "type": "string"
        },
        "lowCost": {
          "type": "boolean"
        },
        "resolution": {
          "type": "string",
          "enum": [
            "360p",
            "720p",
            "1080p",
            "4k",
            "360P",
            "720P",
            "1080P",
            "4K"
          ]
        },
        "fps": {
          "type": "number"
        },
        "isMultimedia": {
          "type": "boolean"
        },
        "multimedia": {
          "type": "boolean"
        },
        "firstFrame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "bytesBase64Encoded": {
                  "type": "string"
                },
                "data": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "lastFrame": {
          "$ref": "#/definitions/VideoGeneration/properties/firstFrame"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "bytesBase64Encoded": {
                  "type": "string"
                },
                "data": {},
                "mimeType": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VideoGeneration/properties/image"
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VideoGeneration/properties/image"
          }
        }
      },
      "required": [
        "prompt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
