{
  "$ref": "#/definitions/FuelTransaction",
  "definitions": {
    "FuelTransaction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "orgId": {
          "type": "string"
        },
        "teamId": {
          "type": "string"
        },
        "targetType": {
          "type": "string",
          "enum": [
            "organization",
            "team",
            "user"
          ]
        },
        "targetId": {
          "type": "string"
        },
        "userId": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "amount": {
          "type": "number"
        },
        "balanceAfter": {
          "type": "number"
        },
        "type": {
          "$ref": "#/definitions/FuelTransactionType"
        },
        "reason": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "resultType": {
          "type": "string"
        },
        "resultId": {
          "type": "string"
        },
        "client": {
          "type": "string",
          "default": "unknown"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {},
          "default": {}
        },
        "createdAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ],
          "default": {}
        }
      },
      "required": [
        "id",
        "amount",
        "type"
      ],
      "additionalProperties": false
    },
    "FuelTransactionType": {
      "type": "string",
      "enum": [
        "usage",
        "consumption",
        "top_up",
        "topup",
        "proration",
        "adjustment",
        "allocation",
        "bonus",
        "refund"
      ]
    }
