{
  "$ref": "#/definitions/FuelPlan",
  "definitions": {
    "FuelPlan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "monthlyAllocation": {
          "type": "number",
          "minimum": 0
        },
        "monthlyFuel": {
          "type": "number",
          "minimum": 0
        },
        "allowRollover": {
          "type": "boolean",
          "default": false
        },
        "rolloverFuel": {
          "type": "boolean",
          "default": false
        },
        "maxRolloverFuel": {
          "type": "number",
          "minimum": 0
        },
        "maxTeamMembers": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "priceMonthlyCents": {
          "type": "integer",
          "minimum": 0
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "stripePriceId": {
          "type": "string"
        },
        "rateLimits": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
