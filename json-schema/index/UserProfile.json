{
  "$ref": "#/definitions/UserProfile",
  "definitions": {
    "UserPreferences": {
      "type": "object",
      "additionalProperties": {},
      "default": {}
    },
    "UserProfile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string",
          "default": ""
        },
        "photoURL": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "format": "uri"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "defaultOrgId": {
          "type": "string"
        },
        "defaultTeamId": {
          "type": "string"
        },
        "orgIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "teamIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "preferences": {
          "$ref": "#/definitions/UserPreferences"
        },
        "onboarding": {
          "type": "object",
          "properties": {
            "completed": {
              "type": "boolean",
              "default": false
            },
            "rolePreference": {
              "type": "string"
            },
            "milestones": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "skipped": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        },
        "createdAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "updatedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
