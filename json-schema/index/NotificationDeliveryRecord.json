{
  "$ref": "#/definitions/NotificationDeliveryRecord",
  "definitions": {
    "NotificationDeliveryRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "notificationId": {
          "type": "string"
        },
        "channel": {
          "type": "string",
          "enum": [
            "in_app",
            "email",
            "web_push",
            "webhook",
            "sms"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "sent",
            "delivered",
            "failed",
            "skipped"
          ]
        },
        "error": {
          "type": "string"
        },
        "sentAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "deliveredAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "recipientId": {
          "type": "string"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "lastAttemptAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "nextAttemptAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "deferredReason": {
          "type": "string",
          "enum": [
            "retry",
            "quiet_hours",
            "digest"
          ]
        }
      },
      "required": [
        "id",
        "notificationId",
        "channel",
        "state"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
