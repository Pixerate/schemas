{
  "$ref": "#/definitions/NotificationDeliveryRecord",
  "definitions": {
    "NotificationChannel": {
      "type": "string",
      "enum": [
        "in_app",
        "email",
        "web_push",
        "webhook",
        "sms"
      ]
    },
    "NotificationDeferredReason": {
      "type": "string",
      "enum": [
        "retry",
        "quiet_hours",
        "digest"
      ]
    },
    "NotificationDeliveryRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "notificationId": {
          "type": "string"
        },
        "channel": {
          "$ref": "#/definitions/NotificationChannel"
        },
        "state": {
          "$ref": "#/definitions/NotificationDeliveryState"
        },
        "error": {
          "type": "string"
        },
        "sentAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "deliveredAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "recipientId": {
          "type": "string"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "lastAttemptAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "nextAttemptAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "deferredReason": {
          "$ref": "#/definitions/NotificationDeferredReason"
        }
      },
      "required": [
        "id",
        "notificationId",
        "channel",
        "state"
      ],
      "additionalProperties": false
    },
    "NotificationDeliveryState": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "failed",
        "skipped"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
