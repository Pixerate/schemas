            "invited",
            "suspended"
          ],
          "default": "active"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "joinedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "invitedBy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
