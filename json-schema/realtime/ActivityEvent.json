{
  "$ref": "#/definitions/ActivityEvent",
  "definitions": {
    "ActivityActionType": {
      "type": "string",
      "enum": [
        "join",
        "leave",
        "create",
        "update",
        "delete",
        "lock",
        "unlock",
        "claim",
        "comment",
        "generate",
        "star",
        "unstar",
        "custom",
        "agent:thought",
        "agent:plan_updated",
        "agent:tool_start",
        "agent:tool_end",
        "agent:approval_requested",
        "agent:approval_resolved",
        "agent:error"
      ]
    },
    "ActivityActor": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "avatarUrl": {
          "type": "string"
        },
        "actorType": {
          "$ref": "#/definitions/ActorType"
        },
        "role": {
          "type": "string"
        },
        "color": {
          "$ref": "#/definitions/PresenceColor"
        }
      },
      "required": [
        "userId"
      ],
      "additionalProperties": false
    },
    "ActivityEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "roomId": {
          "type": "string"
        },
        "entityId": {
          "type": "string"
        },
        "entityType": {
          "type": "string"
        },
        "action": {
          "$ref": "#/definitions/ActivityActionType"
        },
        "actor": {
          "$ref": "#/definitions/ActivityActor"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "payload": {
          "type": "object",
          "additionalProperties": {}
        },
        "timestamp": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "action",
        "actor"
      ],
      "additionalProperties": false
    },
    "ActorType": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "system"
      ]
    },
    "PresenceColor": {
      "type": "string",
      "enum": [
        "slate",
        "gray",
        "zinc",
        "neutral",
        "stone",
        "red",
        "orange",
        "amber",
        "yellow",
        "lime",
        "green",
        "emerald",
        "teal",
        "cyan",
        "sky",
        "blue",
        "indigo",
        "violet",
        "purple",
        "fuchsia",
        "pink",
        "rose"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
