{
  "$ref": "#/definitions/OTRevision",
  "definitions": {
    "OTRevision": {
      "type": "object",
      "properties": {
        "docId": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot": {},
        "appliedOps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "docId": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "authorId": {
                "type": "string"
              },
              "textOps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "retain",
                        "insert",
                        "delete"
                      ]
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "text": {
                      "type": "string"
                    },
                    "attributes": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                }
              },
              "jsonOps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "array",
                      "items": {
                        "type": [
                          "string",
                          "number"
                        ]
                      }
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "set",
                        "delete",
                        "insert",
                        "move",
                        "replace"
                      ]
                    },
                    "value": {},
                    "prevValue": {}
                  },
                  "required": [
                    "path",
                    "type"
                  ],
                  "additionalProperties": false
                }
              },
              "timestamp": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "default": 0
              },
              "metadata": {
                "type": "object",
                "additionalProperties": {},
                "default": {}
              }
            },
            "required": [
              "id",
              "docId",
              "revision",
              "authorId"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "updatedAt": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 0
        }
      },
      "required": [
        "docId",
        "revision"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
