{
  "$ref": "#/definitions/JazzCapability",
  "definitions": {
    "JazzCapability": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "maxLength": 500
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JazzEvidence"
          },
          "minItems": 1,
          "maxItems": 10
        },
        "agentTools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        }
      },
      "required": [
        "name",
        "refs"
      ],
      "additionalProperties": false
    },
    "JazzEvidence": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/JazzEvidenceKind"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "quote": {
          "type": "string",
          "maxLength": 500
        },
        "scope": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false
    },
    "JazzEvidenceKind": {
      "type": "string",
      "enum": [
        "repo",
        "issue",
        "plan",
        "web",
        "metric",
        "absence"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
