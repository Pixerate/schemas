{
  "$ref": "#/definitions/JazzTextObservation",
  "definitions": {
    "JazzTextObservation": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/JazzTextObservationKind"
        },
        "where": {
          "$ref": "#/definitions/JazzTextObservationWhere",
          "default": "paragraph"
        },
        "range": {
          "$ref": "#/definitions/JazzTextRange"
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "replaced": {
          "type": "string",
          "maxLength": 200
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "JazzTextObservationKind": {
      "type": "string",
      "enum": [
        "typed",
        "pasted",
        "deleted",
        "fix-applied",
        "fix-accepted",
        "fix-undone"
      ]
    },
    "JazzTextObservationWhere": {
      "type": "string",
      "enum": [
        "paragraph",
        "before",
        "after",
        "elsewhere"
      ]
    },
    "JazzTextRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
