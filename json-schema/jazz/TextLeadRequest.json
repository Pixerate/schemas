{
  "$ref": "#/definitions/TextLeadRequest",
  "definitions": {
    "JazzTextFlavor": {
      "type": "string",
      "enum": [
        "commonmark",
        "gfm",
        "slack"
      ]
    },
    "JazzTextVoiceId": {
      "type": "string",
      "enum": [
        "punctuate",
        "smart-typography",
        "chat"
      ]
    },
    "JazzTextVoiceState": {
      "type": "object",
      "properties": {
        "voice": {
          "$ref": "#/definitions/JazzTextVoiceId"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "kept": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "undone": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JazzTextVoiceStats"
          },
          "default": {}
        }
      },
      "required": [
        "voice"
      ],
      "additionalProperties": false
    },
    "JazzTextVoiceStats": {
      "type": "object",
      "properties": {
        "kept": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "undone": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "TextLeadRequest": {
      "type": "object",
      "properties": {
        "paragraph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "before": {
          "type": "string",
          "maxLength": 2000
        },
        "after": {
          "type": "string",
          "maxLength": 2000
        },
        "flavor": {
          "$ref": "#/definitions/JazzTextFlavor",
          "default": "gfm"
        },
        "voices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JazzTextVoiceState"
          },
          "maxItems": 10,
          "default": []
        },
        "teamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "paragraph"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
