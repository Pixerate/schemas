{
  "$ref": "#/definitions/JazzObservation",
  "definitions": {
    "JazzAction": {
      "type": "string",
      "enum": [
        "add",
        "remove",
        "edit",
        "select",
        "undo",
        "redo",
        "revert"
      ]
    },
    "JazzObservation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "$ref": "#/definitions/JazzOrigin"
        },
        "action": {
          "$ref": "#/definitions/JazzAction"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JazzTarget"
          },
          "maxItems": 200
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50
        },
        "inGesture": {
          "type": "boolean",
          "default": false
        },
        "summary": {
          "type": "string",
          "maxLength": 280
        }
      },
      "required": [
        "id",
        "at",
        "surface",
        "origin",
        "action",
        "targets"
      ],
      "additionalProperties": false
    },
    "JazzOrigin": {
      "type": "string",
      "pattern": "^(user|agent:.+)$"
    },
    "JazzTarget": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/definitions/JazzTargetKind",
          "default": "node"
        },
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "JazzTargetKind": {
      "type": "string",
      "enum": [
        "node",
        "edge",
        "layer",
        "text",
        "cell",
        "domain",
        "issue",
        "pull-request",
        "file",
        "capability",
        "other"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
