{
  "$ref": "#/definitions/JazzObservation",
  "definitions": {
    "JazzObservation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "pattern": "^(user|agent:.+)$"
        },
        "action": {
          "type": "string",
          "enum": [
            "add",
            "remove",
            "edit",
            "select",
            "undo",
            "redo",
            "revert"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "node",
                  "edge",
                  "layer",
                  "text",
                  "cell",
                  "other"
                ],
                "default": "node"
              },
              "type": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "maxItems": 200
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50
        },
        "inGesture": {
          "type": "boolean",
          "default": false
        },
        "summary": {
          "type": "string",
          "maxLength": 280
        }
      },
      "required": [
        "id",
        "at",
        "surface",
        "origin",
        "action",
        "targets"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
