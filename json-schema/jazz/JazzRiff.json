{
  "$ref": "#/definitions/JazzRiff",
  "definitions": {
    "JazzJsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JazzJsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JazzJsonValue"
          }
        }
      ]
    },
    "JazzOrigin": {
      "type": "string",
      "pattern": "^(user|agent:.+)$"
    },
    "JazzRiff": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "$ref": "#/definitions/JazzOrigin"
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "$ref": "#/definitions/JazzRiffIntent"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "rationale": {
          "type": "string",
          "maxLength": 280
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50,
          "default": []
        },
        "phraseId": {
          "type": "string"
        },
        "toolCalls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JazzToolCall"
          },
          "maxItems": 20,
          "default": []
        },
        "mode": {
          "type": "string",
          "enum": [
            "suggest",
            "assist"
          ]
        },
        "proposalId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/JazzRiffStatus"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "sessionId",
        "origin",
        "surface",
        "strategy",
        "intent",
        "title",
        "confidence",
        "mode",
        "status",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "JazzRiffIntent": {
      "type": "string",
      "enum": [
        "add",
        "annotate",
        "connect",
        "vary",
        "suggest"
      ]
    },
    "JazzRiffStatus": {
      "type": "string",
      "enum": [
        "proposed",
        "applied",
        "accepted",
        "rejected",
        "edited",
        "ignored",
        "withdrawn"
      ]
    },
    "JazzToolCall": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JazzJsonValue"
          },
          "default": {}
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
