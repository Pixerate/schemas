{
  "$ref": "#/definitions/JazzTextLeadV2Response",
  "definitions": {
    "JazzTextEdit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "$ref": "#/definitions/JazzTextEditKind"
        },
        "range": {
          "$ref": "#/definitions/JazzTextRange"
        },
        "replacement": {
          "type": "string",
          "maxLength": 4000
        },
        "action": {
          "$ref": "#/definitions/JazzTextSuggestionKind"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mode": {
          "type": "string",
          "enum": [
            "suggest",
            "assist"
          ],
          "default": "suggest"
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "kind",
        "range",
        "confidence",
        "why"
      ],
      "additionalProperties": false
    },
    "JazzTextEditKind": {
      "type": "string",
      "enum": [
        "spelling",
        "wrong-word",
        "house-style",
        "tone",
        "structure"
      ]
    },
    "JazzTextGenre": {
      "type": "string",
      "enum": [
        "prose",
        "notes",
        "chat",
        "poem",
        "list",
        "technical",
        "heading"
      ]
    },
    "JazzTextLeadV2Response": {
      "type": "object",
      "properties": {
        "tier": {
          "$ref": "#/definitions/JazzTextTier"
        },
        "genre": {
          "$ref": "#/definitions/JazzTextGenre"
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JazzTextEdit"
          },
          "maxItems": 8,
          "default": []
        },
        "holdBack": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 20,
          "description": "Server-only. Local rule ids to hold back for this genre or writer."
        },
        "why": {
          "type": "string",
          "maxLength": 280,
          "description": "Server-only. One-line rationale for the turn."
        },
        "fuelBalance": {
          "type": "integer",
          "description": "Server-only. Remaining fuel balance after the turn, when metered."
        }
      },
      "required": [
        "tier",
        "genre"
      ],
      "additionalProperties": false
    },
    "JazzTextRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "JazzTextSuggestionKind": {
      "type": "string",
      "enum": [
        "list",
        "heading",
        "math",
        "title",
        "alert",
        "quote"
      ]
    },
    "JazzTextTier": {
      "type": "string",
      "enum": [
        "server",
        "on-device"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
